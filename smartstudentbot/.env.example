# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
BASE_URL="https://your-app-name.onrender.com"
WEBHOOK_SECRET="a_very_secret_string_12345"
ADMIN_CHAT_ID="your_telegram_chat_id"

# APIs
OPENWEATHERMAP_API_KEY=""
EXCHANGE_RATE_API_KEY=""
HUGGINGFACE_API_KEY="" # Optional

# Redis (Upstash)
REDIS_URL="rediss://default:password@region.upstash.io:port"

# Google Service Account (Base64 encoded JSON)
# To get this:
# 1. Create a Google Cloud Service Account.
# 2. Enable Google Drive API and Google Sheets API.
# 3. Share your Google Sheet and Drive Folder with the service account's email address.
# 4. Download the JSON key file.
# 5. Base64 encode the content of the JSON file (e.g., using `base64 -w 0 < your-file.json` on Linux)
GOOGLE_CREDS_BASE64=""

# Google Service IDs
SHEET_ID="your_google_sheet_id"
GOOGLE_DRIVE_UPLOAD_FOLDER_ID="your_google_drive_folder_id"

# Data sources (GitHub Raw URL)
# Example: https://raw.githubusercontent.com/your-username/your-repo/main/data
GITHUB_DATA_URL="https://raw.githubusercontent.com/your-username/smart-student-bot-data/main"

# Bot Settings
DEFAULT_CITY="Perugia"
DEFAULT_LANG="fa"

# Webserver Port (Render sets this automatically, but good for local dev)
PORT="8000"
